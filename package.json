{
  "name": "dance-course-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit",
    "test:all": "npm test && npm run test:integration:setup && npm run test:integration",
    "test:e2e": "playwright test",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:integration:setup": "tsx tests/integration/setup-test-database.ts",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"tests/unit/*.test.ts\"",
    "telegram:alert:preview": "tsx src/lib/telegram/preview-purchase-alert.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:audit:invariants": "tsx src/db/audit-invariants.ts",
    "db:audit:legacy-contract": "tsx src/db/audit-legacy-contract.ts",
    "db:audit:legacy-contract:postflight": "tsx src/db/audit-legacy-contract-postflight.ts",
    "db:audit:monthly-sales-report": "tsx src/db/audit-monthly-sales-report.ts",
    "db:backfill:stripe-settlement": "tsx src/db/backfill-stripe-settlement.ts",
    "db:backfill:stripe-settlement:dev": "env -u STRIPE_SECRET_KEY NODE_ENV=development DATABASE_ENV=development tsx src/db/backfill-stripe-settlement.ts",
    "db:backfill:stripe-settlement:prod": "NODE_ENV=production DATABASE_ENV=production tsx src/db/backfill-stripe-settlement.ts",
    "db:catalog:verify": "tsx src/db/verify-sellable-products.ts",
    "db:catalog:verify:dev": "DATABASE_ENV=development npm run db:catalog:verify",
    "db:catalog:verify:prod": "DATABASE_ENV=production npm run db:catalog:verify",
    "db:env": "tsx src/db/print-env.ts",
    "db:health": "tsx src/db/health.ts",
    "db:health:dev": "DATABASE_ENV=development npm run db:health",
    "db:health:prod": "DATABASE_ENV=production npm run db:health",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:migrate:check": "MIGRATION_DRY_RUN=1 tsx src/db/run-migrations.ts",
    "db:operations:status": "tsx src/db/operational-status.ts",
    "db:jobs:replay": "tsx src/db/replay-durable-job.ts",
    "db:jobs:run": "tsx src/db/run-stripe-background-jobs.ts",
    "db:business-jobs:run": "tsx src/db/run-business-operation-jobs.ts",
    "db:seed:products": "tsx src/db/seed-products.ts",
    "db:snapshot:decrypt": "tsx src/db/decrypt-source-snapshot.ts",
    "db:snapshot:legacy-contract": "tsx src/db/capture-source-snapshot.ts",
    "db:status:dev": "DATABASE_ENV=development npm run db:operations:status",
    "db:status:prod": "DATABASE_ENV=production npm run db:operations:status",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx src/db/verify.ts",
    "db:verify:dev": "DATABASE_ENV=development npm run db:verify",
    "db:verify:prod": "DATABASE_ENV=production npm run db:verify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint",
    "prepare": "husky",
    "fix": "npm run lint:fix && npm run format",
    "verify": "npm run check && npm run typecheck && npm test && npm run build",
    "verify:full": "npm run check && npm run typecheck && npm run test:all && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-input/mask": "^2.0.4",
    "@react-pdf/renderer": "~4.6.1",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.68.0",
    "mixpanel-browser": "^2.84.0",
    "mobx": "^7.1.4",
    "mobx-react-lite": "^5.1.2",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "plyr": "3.8.4",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "styled-components": "^6.6.0",
    "swiper": "^14.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@react-pdf/textkit": "6.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.21": true,
    "core-js@3.51.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
