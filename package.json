{
  "name": "dance-course-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-migrations": "npm run db:migrate && npm run build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:backfill:sheets": "tsx src/db/backfill-google-sheets.ts",
    "db:backfill:stripe-settlement": "tsx src/db/backfill-stripe-settlement.ts",
    "db:backfill:stripe-settlement:dev": "env -u STRIPE_SECRET_KEY NODE_ENV=development DATABASE_ENV=development tsx src/db/backfill-stripe-settlement.ts",
    "db:backfill:stripe-settlement:prod": "NODE_ENV=production DATABASE_ENV=production tsx src/db/backfill-stripe-settlement.ts",
    "db:compare:sheets": "tsx src/db/compare-google-sheets.ts",
    "db:env": "tsx src/db/print-env.ts",
    "db:health": "tsx src/db/health.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "NODE_ENV=development DATABASE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "NODE_ENV=production DATABASE_ENV=production drizzle-kit migrate",
    "db:seed:products": "tsx src/db/seed-products.ts",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx src/db/verify.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint",
    "prepare": "husky",
    "fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@react-input/mask": "^2.0.4",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "next": "^16.2.9",
    "next-intl": "^4.13.0",
    "plyr": "^3.8.4",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.2.0",
    "styled-components": "^6.4.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.15"
    }
  }
}
