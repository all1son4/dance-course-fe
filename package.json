{
  "name": "dance-course-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit",
    "test:baseline": "tsx --test src/db/reconciliation-baseline.test.ts",
    "test:e2e": "playwright test",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:integration:setup": "tsx tests/integration/setup-test-database.ts",
    "test:unit": "tsx --test src/**/*.test.ts tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:audit:monthly-sales-report": "tsx src/db/audit-monthly-sales-report.ts",
    "db:backfill:sheets": "tsx src/db/backfill-google-sheets.ts",
    "db:backfill:stripe-settlement": "tsx src/db/backfill-stripe-settlement.ts",
    "db:backfill:stripe-settlement:dev": "env -u STRIPE_SECRET_KEY NODE_ENV=development DATABASE_ENV=development tsx src/db/backfill-stripe-settlement.ts",
    "db:backfill:stripe-settlement:prod": "NODE_ENV=production DATABASE_ENV=production tsx src/db/backfill-stripe-settlement.ts",
    "db:baseline:sheets": "tsx src/db/capture-reconciliation-baseline.ts",
    "db:compare:sheets": "tsx src/db/compare-google-sheets.ts",
    "db:env": "tsx src/db/print-env.ts",
    "db:health": "tsx src/db/health.ts",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:migrate:check": "MIGRATION_DRY_RUN=1 tsx src/db/run-migrations.ts",
    "db:seed:products": "tsx src/db/seed-products.ts",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx src/db/verify.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint",
    "prepare": "husky",
    "fix": "npm run lint:fix && npm run format",
    "verify": "npm run check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-input/mask": "^2.0.4",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "next": "^16.3.0",
    "next-intl": "^4.13.4",
    "plyr": "^3.8.4",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.3.2",
    "styled-components": "^6.4.4",
    "swiper": "^14.0.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true,
    "@swc/core@1.15.40": true,
    "core-js@3.49.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
